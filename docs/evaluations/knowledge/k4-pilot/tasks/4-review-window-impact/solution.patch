@@ -8,7 +8,7 @@ export function addDays(date: string, days: number): string {
   return day.toISOString().slice(0, 10);
 }
 
-/** Whether `today` is in the window of a stay checked out on `checkOut`: after it, and at most 14 days after it. */
+/** Whether `today` is in the window of a stay checked out on `checkOut`: after it, and at most `REVIEW_WINDOW_DAYS` days after it. */
