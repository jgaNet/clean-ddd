+describe('Archiving a conversation', () => {
+  it('leaves it out of the archiver’s list only, until a new message is written in it', async () => {
+    const host = await account('conv-host-archive@example.com', ['host']);
+    const traveller = await account('conv-traveller-archive@example.com', ['traveller']);
+    const listingId = await listing(host.token);
+    const conversationId = (await write(traveller.token, listingId, 'Hello')).result!.id;
+
+    expect((await command('POST', `/conversations/${conversationId}/archive`, undefined, traveller.token)).status).toBe(
+      'SUCCESS',
+    );
+    expect((await mine(traveller.token)).map(each => each.id)).not.toContain(conversationId);
+    expect((await mine(host.token)).map(each => each.id)).toContain(conversationId);
+
+    await command('POST', `/conversations/${conversationId}/messages`, { text: 'Welcome' }, host.token);
+    expect((await mine(traveller.token)).map(each => each.id)).toContain(conversationId);
+  });
+
+  it('is refused to whoever does not read the conversation', async () => {
+    const host = await account('conv-host-archive-2@example.com', ['host']);
+    const traveller = await account('conv-traveller-archive-2@example.com', ['traveller']);
+    const stranger = await account('conv-stranger-archive@example.com', ['traveller']);
+    const conversationId = (await write(traveller.token, await listing(host.token), 'Hello')).result!.id;
+    expect((await command('POST', `/conversations/${conversationId}/archive`, undefined, stranger.token)).status).toBe(
+      'ERROR',
+    );
+  });
+});
