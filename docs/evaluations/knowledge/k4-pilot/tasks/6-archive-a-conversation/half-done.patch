+import { CommandHandler, ExecutionContext } from '@Architecture/Application';
+import { IResult, NotFoundException, Result } from '@Architecture/Domain';
+import { requireSignedIn } from '@SharedKernel/Application/Guards';
+
+import { IConversationRepository } from '@Contexts/Messaging/Domain/Conversation/Ports/IConversationRepository';
+import { accessOf } from '@Contexts/Messaging/Application/ConversationAccess';
+import { IListingHosts } from '@Contexts/Messaging/Application/Ports/IListingHosts';
+
+import { ArchiveConversationCommandEvent } from './ArchiveConversationCommandEvent';
+
+/**
+ * The caller archives a conversation they read, for themselves: it leaves their list until a new message is written in it. To anyone who
+ * does not read it, the conversation does not exist.
+ */
+export class ArchiveConversationCommandHandler extends CommandHandler<ArchiveConversationCommandEvent> {
+  constructor(
+    private readonly conversations: IConversationRepository,
+    private readonly listings: IListingHosts,
+  ) {
+    super();
+  }
+
+  async execute({ payload }: ArchiveConversationCommandEvent, context: ExecutionContext): Promise<IResult<unknown>> {
+    const by = requireSignedIn(context, 'Messaging');
+    if (by.isFailure()) return by;
+
+    const conversation = await this.conversations.findById(payload.conversationId);
+    if (!conversation) return Result.fail(new NotFoundException('Messaging', 'Conversation not found'));
+
+    const facts = await this.listings.findListing(conversation.listingId, by.data.value);
+    if (!facts) return Result.fail(new NotFoundException('Messaging', 'Conversation not found'));
+
+    const archived = conversation.archiveFor(accessOf(facts, by.data));
+    if (archived.isFailure()) return archived;
+
+    const saved = await this.conversations.save(conversation);
+    if (saved.isFailure()) return saved;
+
+    this.publishDomainEvents(conversation, context);
+    return Result.ok();
+  }
+}
