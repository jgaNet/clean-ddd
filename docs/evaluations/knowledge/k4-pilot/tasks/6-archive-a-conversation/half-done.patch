@@ -0,0 +1,53 @@
+import { Id } from '@Architecture/Domain';
+
+import { Conversation, ConversationAccess } from './Conversation';
+import { ConversationArchivedEvent } from './ConversationEvents';
+import { MessageText } from './MessageText';
+
+const AT = new Date('2027-01-01T10:00:00Z');
+const traveller = Id.generate();
+const host = Id.generate();
+const text = (value: string) => MessageText.create(value).data!;
+const access = (by: Id, extra: Partial<ConversationAccess> = {}): ConversationAccess => ({
+  hostId: host.value,
+  by,
+  managesOrganisation: false,
+  viewsOrganisation: false,
+  ...extra,
+});
+const started = () =>
+  Conversation.start({ listingId: 'l1', traveller, hostId: host.value, text: text('Hello'), bookings: [], sentAt: AT })
+    .data!;
+
+describe('Conversation archives', () => {
+  it('is archived for the reader who archives it only, until a message is written after it', () => {
+    const conversation = started();
+    conversation.pullDomainEvents();
+
+    expect(conversation.archiveFor(access(traveller)).isSuccess()).toBe(true);
+    expect(conversation.isArchivedBy(traveller.value)).toBe(true);
+    expect(conversation.isArchivedBy(host.value)).toBe(false);
+    expect(conversation.pullDomainEvents()).toEqual([expect.any(ConversationArchivedEvent)]);
+
+    conversation.send(access(host), text('Answer'), AT);
+    expect(conversation.isArchivedBy(traveller.value)).toBe(false);
+  });
+
+  it('records nothing new when archived again, and refuses whoever does not read it', () => {
+    const conversation = started();
+    conversation.archiveFor(access(host));
+    conversation.pullDomainEvents();
+
+    expect(conversation.archiveFor(access(host)).isSuccess()).toBe(true);
+    expect(conversation.pullDomainEvents()).toEqual([]);
+    expect(conversation.archiveFor(access(Id.generate())).error?.type).toBe('NotFound');
+    expect(conversation.archiveFor(access(Id.generate(), { viewsOrganisation: true })).isSuccess()).toBe(true);
+  });
+
+  it('keeps the archives through a snapshot', () => {
+    const conversation = started();
+    conversation.archiveFor(access(traveller));
+    const again = Conversation.fromSnapshot(conversation.toSnapshot());
+    expect(again.isArchivedBy(traveller.value)).toBe(true);
+  });
+});
