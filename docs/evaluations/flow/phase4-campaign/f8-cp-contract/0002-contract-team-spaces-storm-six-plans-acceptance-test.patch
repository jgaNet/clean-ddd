+
+changes:
+  - kind: integration-event
+    name: MemberInvitedIntegrationEvent
+    aggregate: Space
+    new: false
+  - kind: aggregate
+    name: Notification
+    new: false
+  - kind: event-handler
+    name: MemberInvited
+    new: true
+  - kind: event-handler
+    name: MemberRemoved
+    new: true
+  - kind: event-handler
+    name: MemberRoleChanged
+    new: true
+
+invariants:
+  - Each notification is exactly the fields of its kind; only the account concerned lists it.
+  - Earlier kinds are unchanged.
+
+events:
+  - NotificationCreatedEvent
+
+crossContext:
+  context: Teams
+  strategy: integration-event
+  why: >-
+    The invited, the removed and those whose role changes are told; Teams publishes the facts.
+
+architectureChanges: false
