+    policies:
+      - { on: MemberInvited, kind: integration-event, publishes: [], events: [NotificationCreated] }
+      - { on: MemberRemoved, kind: integration-event, publishes: [], events: [NotificationCreated] }
+      - { on: MemberRoleChanged, kind: integration-event, publishes: [], events: [NotificationCreated] }
+
+links:
+  - { mechanism: owned-port, upstream: Accounts, downstream: Teams, contracts: [AccountDirectory] }
+  - { mechanism: owned-port, upstream: Teams, downstream: Notes, contracts: [SpaceMembership] }
+  - { mechanism: owned-port, upstream: Plans, downstream: Teams, contracts: [SeatLimits] }
+  - mechanism: integration-event
+    upstream: Teams
+    downstream: Plans
+    contracts: [MemberJoined, MemberLeft, MemberRemoved, MemberRoleChanged, SpaceCreated]
+  - mechanism: integration-event
+    upstream: Teams
