+      - { on: NoteChanged, kind: integration-event, publishes: [], events: [] }
+      - { on: SpaceCreated, kind: integration-event, publishes: [], events: [] }
+      - { on: MemberJoined, kind: integration-event, publishes: [], events: [] }
+      - { on: MemberRemoved, kind: integration-event, publishes: [], events: [] }
+      - { on: MemberLeft, kind: integration-event, publishes: [], events: [] }
+  - id: Audit
+    commands: []
+    queries:
+      - name: GetSpaceActivity
+        actor: a signed-in account
+        route: GET /audit/spaces/{param}
+    events: [ActivityRecorded]
+    policies:
+      - { on: SpaceCreated, kind: integration-event, publishes: [], events: [] }
+      - { on: MemberInvited, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+      - { on: MemberJoined, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+      - { on: MemberRemoved, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+      - { on: MemberLeft, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+      - { on: MemberRoleChanged, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+      - { on: NoteChanged, kind: integration-event, publishes: [], events: [ActivityRecorded] }
+  - id: Notifications
+    commands: []
