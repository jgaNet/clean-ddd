+schemaVersion: 1
+
+feature: team-spaces
+language: typescript
+context: Search
+
+intent: >-
+  `GET /search?q=` answers [{ noteId, title, spaceId }] of the notes the caller can read — their
+  own personal notes, those shared with them, their spaces' notes — containing every word in title
+  or text, ignoring case; archived excluded; most recently changed first. Search keeps its own
+  projection, fed only by NoteChangedIntegrationEvent (Notes) and the membership facts of
+  SpaceIntegrationEvents.ts (Teams), both frozen. Fill the module and the routes under `/search`.
+  The other slices are written at the same time.
+
+changes:
+  - kind: integration-event
+    name: NoteChangedIntegrationEvent
+    aggregate: Note
+    new: false
+  - kind: query
+    name: SearchNotes
+    verb: read
+    route: GET /search
+    new: true
+  - kind: event-handler
+    name: NoteChanged
+    new: true
+
+invariants:
+  - Search reads no other context's store and imports no other context's Domain.
+  - A member removed from a space, or who leaves it, stops finding its notes once the fact is handled.
+  - An anonymous caller is refused (403).
+
+events: []
+
+crossContext:
+  context: Notes
+  strategy: integration-event
+  why: >-
+    Search projects the notes from what Notes publishes on every change. (It learns who belongs to
+    which space from what Teams publishes, the same way.)
+
+architectureChanges: false
