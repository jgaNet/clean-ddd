@@ -0,0 +1,65 @@
+import { IntegrationEvent } from '@Architecture/Domain/EventTypes';
+
+/** A member's role in a space, in Teams' public words. */
+export type SpaceRoleName = 'reader' | 'editor' | 'admin';
+
+export interface SpaceCreatedPayload {
+  spaceId: string;
+  name: string;
+  /** The account that created it, its first admin. */
+  adminId: string;
+  /** ISO 8601. */
+  createdAt: string;
+}
+export interface MemberInvitedPayload {
+  spaceId: string;
+  spaceName: string;
+  accountId: string;
+  role: SpaceRoleName;
+  invitedBy: string;
+  /** ISO 8601. */
+  invitedAt: string;
+}
+export interface MemberJoinedPayload {
+  spaceId: string;
+  accountId: string;
+  role: SpaceRoleName;
+  /** ISO 8601. */
+  joinedAt: string;
+}
+export interface MemberRemovedPayload {
+  spaceId: string;
+  spaceName: string;
+  accountId: string;
+  removedBy: string;
+  /** ISO 8601. */
+  removedAt: string;
+}
+export interface MemberLeftPayload {
+  spaceId: string;
+  accountId: string;
+  /** ISO 8601. */
+  leftAt: string;
+}
+export interface MemberRoleChangedPayload {
+  spaceId: string;
+  spaceName: string;
+  accountId: string;
+  role: SpaceRoleName;
+  changedBy: string;
+  /** ISO 8601. */
+  changedAt: string;
+}
+
+/** Published by Teams when an account creates a space, of which it is the first admin. */
+export class SpaceCreatedIntegrationEvent extends IntegrationEvent<SpaceCreatedPayload> {}
+/** Published by Teams when an admin invites an account into a space. */
+export class MemberInvitedIntegrationEvent extends IntegrationEvent<MemberInvitedPayload> {}
+/** Published by Teams when an invited account accepts, and so becomes a member. */
+export class MemberJoinedIntegrationEvent extends IntegrationEvent<MemberJoinedPayload> {}
+/** Published by Teams when an admin removes a member. */
+export class MemberRemovedIntegrationEvent extends IntegrationEvent<MemberRemovedPayload> {}
+/** Published by Teams when a member leaves a space. */
+export class MemberLeftIntegrationEvent extends IntegrationEvent<MemberLeftPayload> {}
+/** Published by Teams when an admin changes a member's role. */
+export class MemberRoleChangedIntegrationEvent extends IntegrationEvent<MemberRoleChangedPayload> {}
