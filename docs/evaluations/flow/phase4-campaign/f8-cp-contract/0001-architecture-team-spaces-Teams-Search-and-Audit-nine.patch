+/** A space's plan as other contexts may read it: its seats, and how many notes it keeps (null: no limit). */
+export interface SpacePlanView {
+  plan: 'free' | 'team';
+  seats: number;
+  noteLimit: number | null;
+}
+
+/**
+ * Plans' read model of spaces, frozen by the architecture task of team spaces (ADR 6) for the
+ * relationships Plans → Teams (seats) and Plans → Notes (a space's note limit). A space that never
+ * chose a plan is on Free: 3 seats, 50 notes.
+ */
+export interface ISpacePlanQueries {
+  spacePlanOf(spaceId: string): Promise<SpacePlanView>;
+}
