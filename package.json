{
  "name": "clean-ddd",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/application.js",
  "types": "dist/application.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/application.js",
    "start:dev": "nodemon --ext js,ts,json,env --exec 'tsx --tsconfig ./tsconfig.json' src/Bootstrap/Fastify/application.ts",
    "build": "node ./deployments/build.js",
    "build:clean": "rm -rf tsconfig.build.tsbuildinfo && rm -rf ./dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:watch": "nodemon --ext js,ts,json,env --exec 'yarn test'",
    "test:coverage": "yarn test --coverage",
    "test:units": "yarn test --passWithNoTests --testPathIgnorePatterns=e2e.spec.ts",
    "test:e2e": "yarn test --passWithNoTests --testPathPatterns=e2e.spec.ts",
    "test:ci": "yarn test --colors --coverage --ci",
    "lint": "eslint .",
    "check:conventions": "node tools/check-conventions.mjs",
    "conventions:write": "node tools/check-conventions.mjs --write",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "json-schema-to-ts": "^3.1.1",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/superagent": "^8.1.11",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "superagent": "^10.4.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "typescript-eslint": "^8.71.0"
  }
}
