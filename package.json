{
  "name": "clean-ddd",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/application.js",
  "types": "dist/application.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/application.js",
    "start:dev": "nodemon --ext js,ts,json,env --exec 'tsx --tsconfig ./tsconfig.json' src/Bootstrap/Fastify/application.ts",
    "build": "node ./deployments/build.js",
    "build:clean": "rm -rf tsconfig.build.tsbuildinfo && rm -rf ./dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:watch": "nodemon --ext js,ts,json,env --exec 'yarn test'",
    "test:coverage": "npm run test -- --coverage",
    "test:units": "npm run test -- --passWithNoTests --testPathIgnorePatterns=e2e.spec.ts",
    "test:e2e": "npm run test -- --passWithNoTests --testPathPattern=e2e.spec.ts",
    "test:ci": "npm run test -- --colors --coverage --ci",
    "lint": "eslint --ext .ts,.js .",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/websocket": "^11.0.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.3.1",
    "fastify": "^5.2.1",
    "jose": "^6",
    "json-schema-to-ts": "^2.9.2",
    "tslib": "^2.3.1",
    "uuid": "^9.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@jest/globals": "^29",
    "@jest/types": "^29",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "cross-env": "^7.0.3",
    "eslint": "^8.12.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-tsdoc": "^0.2.14",
    "husky": "^8.0.1",
    "jest": "^29",
    "lint-staged": "^13.0.0",
    "nodemon": "^2.0.15",
    "prettier": "^2.6.1",
    "superagent": "^10.1.1",
    "ts-jest": "^29",
    "ts-node": "^10.7.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9"
  }
}
